# Local environment files can contain database credentials and other secrets.
# Keep every developer-specific variant out of Git while allowing a deliberately
# credential-free example file if the project chooses to add one later.
.env
.env.*
!.env.example

# PostgreSQL archives contain private inquiries, credential verifiers, and
# managed media. Keep complete dumps, checksums, and in-progress artifacts out
# of source control even when an operator temporarily places them in this tree.
/backups/
*.pgdump
*.pgdump.sha256
*.pgdump.tmp
*.sha256.tmp
