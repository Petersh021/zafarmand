# PostgreSQL migration files are executed across Windows and deployment hosts.
# Store them with deterministic LF endings to avoid noisy diffs and keep SQL
# tooling behavior consistent regardless of each contributor's Git settings.
migrations/*.sql text eol=lf

# Deployment scripts run under Bash on Linux even when edited from Windows.
# Store their interpreter line and commands with deterministic LF endings.
scripts/*.sh text eol=lf
